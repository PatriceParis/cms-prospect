# Copier en .env pour le développement local (jamais versionné).

# Mot de passe d'accès au CRM. Valeur de développement local uniquement :
# en production, il est défini dans Vercel (Settings > Environment Variables).
CRM_PASSWORD=dev-local

# Base Turso (optionnel en local : sans ces variables, data/prospection.db est utilisé).
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=...

# Maquettes de prospection (outil Fold, admin → Prospects → Connexion CRM).
# Aussi à définir dans Vercel pour la synchronisation et les notifications.
# FOLD_API_KEY=fold_...
# FOLD_WEBHOOK_SECRET=whsec_...
# FOLD_API_URL=https://test.fold-medias.com/api/v1   (par défaut : serveur de test)

# E-mails de prospection (Resend). Aussi à définir dans Vercel.
# RESEND_API=re_...                      clé d'envoi
# MAIL_FROM=prenom@envoi.exemple.fr      adresse d'un domaine vérifié chez Resend
# MAIL_REPLY_TO=contact@exemple.fr       boîte où arrivent les réponses
# APP_URL=https://cms-prospect.vercel.app   (lien de désinscription)
